# --- Telegram (обязательно для бота) -------------------------------------
# Создайте бота у @BotFather и вставьте токен
TELEGRAM_BOT_TOKEN=
# Через запятую: Telegram user id, которым разрешён доступ (пусто = всем)
TELEGRAM_ADMIN_IDS=

# --- База данных ---------------------------------------------------------
# Локально по умолчанию SQLite (data/arb.db). В Docker Compose используется PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://arb:arb@postgres:5432/arb
DATABASE_URL=

# --- Необязательные ключи источников --------------------------------------
# The Odds API: бесплатный план 500 кредитов/мес — https://the-odds-api.com
# Даёт 1xBet (международный), Pinnacle, Marathonbet, Betfair/Matchbook (back+lay) по теннису
ODDS_API_KEY=
# Betfair Exchange API-NG: app key + session token из ВАШЕГО аккаунта (бот не логинится за вас)
BETFAIR_APP_KEY=
BETFAIR_SESSION_TOKEN=

# --- Параметры сканера ---------------------------------------------------
SCAN_INTERVAL_SECONDS=90
DEFAULT_CAPITAL_USD=1000
DEFAULT_MIN_ROI_PCT=3
DEFAULT_MAX_QUOTE_AGE_SECONDS=20
KZT_PER_USD_FALLBACK=520
LOG_LEVEL=INFO

# --- Браузер (Zendriver / Chrome) для Olimpbet, Fonbet, Parimatch, Winline, Tennisi ---
BROWSER_HEADLESS=true
# пусто = автопоиск chrome/chromium
BROWSER_PATH=
BROWSER_NO_SANDBOX=false

# --- Прокси-менеджер (app/proxy_manager) ---------------------------------
# Выключен. Прокси НЕ используются для обхода 403/капчи/геоблока и никогда для Telegram/API-ключей.
PROXY_MANAGER_ENABLED=false
# API proxy-tools.com доступен только с платным Pro Status
PROXY_TOOLS_API_KEY=
# свои прокси: socks5://host:port https://host:port
PROXY_LIST=
# провайдеры, для которых использование прокси разрешено (пусто = ни для каких)
PROXY_ALLOWED_PROVIDERS=

# --- Коммерческая часть ---------------------------------------------------
# Telegram ID администраторов (через запятую) — доступ к /admin
BOT_ADMIN_IDS=
# второй фактор для чувствительных админ-действий (/auth <PIN>); пусто = такие действия отключены
ADMIN_PIN=
# реальные платежи ВЫКЛЮЧЕНЫ, пока владелец явно не включит
PAYMENTS_ENABLED=false
# Telegram Stars (XTR): подписка активируется только по successful_payment от Telegram
PAYMENTS_PROVIDER=telegram_stars
# контакт поддержки для /support (например @kirbet_support)
SUPPORT_CONTACT=
